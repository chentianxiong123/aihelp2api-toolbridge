# OIHelp API 配置示例
# 复制为 .env 并修改参数

# API 鉴权
API_KEY=sk-oihelp

# 服务配置
PORT=8000
HOST=0.0.0.0

# 默认模型
DEFAULT_MODEL=gpt-5.5-low

# 上游超时（秒）
UPSTREAM_TIMEOUT=60
UPSTREAM_CONNECT_TIMEOUT=10

# 账号管理
ACCOUNTS_FILE=accounts.json
ACCOUNT_MIN_THRESHOLD=3
AUTO_REGISTER_COUNT=5
REGISTER_PREFIX=oi_
DEFAULT_PASSWORD=oihelp2024

# 环境变量回退（无 accounts.json 时）
OIHELP_USERNAME=
OIHELP_SESSION_TOKEN=
OIHELP_PASSWORD=oihelp2024
